{
  "name": "reel-components-kit",
  "version": "2.0.0",
  "description": "Production Remotion components for brand reels (Dhunna Infra, Crown Crest): themed, frame-driven, agent-ready. See CATALOG.md.",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "studio": "remotion studio src/demo/kit-entry.ts",
    "typecheck": "tsc --noEmit",
    "stills": "TMPDIR=\"/Volumes/disk 2/tmp/render\" node scripts/stills.mjs",
    "render": "TMPDIR=\"/Volumes/disk 2/tmp/render\" remotion render src/demo/kit-entry.ts",
    "test": "tsx scripts/test-manifest.ts",
    "schema": "tsx scripts/export-manifest-schema.ts"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.0.0",
    "@remotion/three": "^4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "remotion": "^4.0.0",
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/bundler": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "@remotion/three": "4.0.536",
    "@remotion/zod-types": "4.0.536",
    "@types/react": "^19.3.0",
    "@types/three": "0.186.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.536",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "typescript": "^5.0.0",
    "zod": "4.5.4"
  }
}
